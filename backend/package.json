{
    "name": "backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.mjs",
    "scripts": {
        "build": "prisma generate && vp pack",
        "start": "node --env-file-if-exists=.env dist/index.mjs",
        "dev": "node --import=vite-plus/register scripts/dev.ts",
        "dev:api": "node --import=vite-plus/register --env-file-if-exists=.env src/index.ts",
        "check-types": "tsc --noEmit",
        "prisma:deploy": "prisma migrate deploy",
        "prestart": "prisma migrate deploy",
        "predev": "prisma migrate deploy && prisma generate",
        "worker": "node --env-file-if-exists=.env dist/worker.mjs",
        "dev:worker": "node --import=vite-plus/register --env-file-if-exists=.env src/worker.ts"
    },
    "dependencies": {
        "@better-auth/infra": "^0.4.30",
        "@google-cloud/storage": "^7.8.0",
        "@google/genai": "^3.3.0",
        "@hono/node-server": "^2.1.8",
        "@opentelemetry/api": "^1.10.0",
        "@prisma/client": "^5.10.1",
        "@quizqrafter/shared": "*",
        "bcrypt": "^5.1.1",
        "better-auth": "^1.7.22",
        "bullmq": "^6.7.6",
        "dejavu-fonts-ttf": "^2.37.3",
        "hono": "^4.13.18",
        "mammoth": "^1.13.0",
        "pdfkit": "^0.20.2",
        "pg": "^8.23.1",
        "prisma": "^5.10.1",
        "resend": "^6.38.0",
        "unpdf": "^2.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/node": "^20.11.19",
        "@types/pdfkit": "^0.17.7",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "jszip": "^3.10.2",
        "supertest": "^7.3.2",
        "typescript": "^5.3.3",
        "vite-plus": "1.6.0"
    }
}
