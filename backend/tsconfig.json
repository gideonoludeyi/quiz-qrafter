{
    "compilerOptions": {
        "target": "es2022",
        "module": "preserve",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "moduleResolution": "bundler"
    },
    "include": ["src", "test", "scripts"]
}
