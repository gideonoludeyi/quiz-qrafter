// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int        @id @default(autoincrement())
    email     String     @unique
    fullname  String
    password  String
    documents Document[]

    @@map("users")
}

model Document {
    id               Int      @id @default(autoincrement())
    filename         String
    mimeType         String
    size             Int
    // Null until a quiz job has read the file.
    transcriptionURL String?
    rawURL           String
    createdAt        DateTime  @default(now())
    userId           Int
    user             User      @relation(fields: [userId], references: [id])
    quiz             Quiz?
    jobs             QuizJob[]

    @@map("documents")
}

model Quiz {
    id         Int        @id @default(autoincrement())
    title      String
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    document   Document   @relation(fields: [documentId], references: [id])
    documentId Int        @unique
    questions  Question[]

    @@map("quizzes")
}

enum QuestionType {
    multiple_choice
    true_false
    short_answer
}

model Question {
    id          Int          @id @default(autoincrement())
    position    Int
    type        QuestionType
    prompt      String
    choices     String[]
    // multiple_choice: index of the correct choice; true_false: boolean; short_answer: string
    answer      Json
    explanation String
    sourceQuote String?
    quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
    quizId      Int

    @@index([quizId])
    @@map("questions")
}

enum JobStatus {
    queued
    running
    succeeded
    failed
}

enum JobStage {
    reading
    writing
    saving
}

// One run of reading a document and writing its quiz. At most one per
// document is queued or running (a partial unique index in the migration).
model QuizJob {
    id               Int       @id @default(autoincrement())
    document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
    documentId       Int
    status           JobStatus @default(queued)
    stage            JobStage?
    questionsWritten Int       @default(0)
    attempts         Int       @default(0)
    runAfter         DateTime  @default(now())
    heartbeatAt      DateTime?
    // A message safe to show the user.
    error            String?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    finishedAt       DateTime?

    @@index([status, runAfter])
    @@index([documentId])
    @@map("quiz_jobs")
}
