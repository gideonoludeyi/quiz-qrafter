// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// The user, session, account and verification models follow better-auth's core schema.
// IDs are serial integers (better-auth's generateId: "serial").
model User {
    id            Int        @id @default(autoincrement())
    name          String
    email         String     @unique
    emailVerified Boolean    @default(false)
    image         String?
    createdAt     DateTime   @default(now())
    updatedAt     DateTime   @updatedAt
    sessions      Session[]
    accounts      Account[]
    documents     Document[]

    @@map("users")
}

model Session {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    token     String   @unique
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@map("sessions")
}

// One way of signing in. Email and password sign-in is providerId "credential",
// with the password hash in `password`.
model Account {
    id                    Int       @id @default(autoincrement())
    userId                Int
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    idToken               String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("accounts")
}

// Short-lived tokens, such as password reset tokens.
model Verification {
    id         Int      @id @default(autoincrement())
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verifications")
}

model Document {
    id               Int      @id @default(autoincrement())
    filename         String
    mimeType         String
    size             Int
    // Null until a quiz job has read the file.
    transcriptionURL String?
    rawURL           String
    createdAt        DateTime  @default(now())
    userId           Int
    user             User      @relation(fields: [userId], references: [id])
    quiz             Quiz?
    jobs             QuizJob[]

    @@map("documents")
}

model Quiz {
    id         Int        @id @default(autoincrement())
    title      String
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    document   Document   @relation(fields: [documentId], references: [id])
    documentId Int        @unique
    questions  Question[]

    @@map("quizzes")
}

enum QuestionType {
    multiple_choice
    true_false
    short_answer
}

model Question {
    id          Int          @id @default(autoincrement())
    position    Int
    type        QuestionType
    prompt      String
    choices     String[]
    // multiple_choice: index of the correct choice; true_false: boolean; short_answer: string
    answer      Json
    explanation String
    sourceQuote String?
    quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
    quizId      Int

    @@index([quizId])
    @@map("questions")
}

enum JobStatus {
    queued
    running
    succeeded
    failed
}

enum JobStage {
    reading
    writing
}

// One run of reading a document and writing its quiz. At most one per
// document is queued or running (a partial unique index in the migration).
model QuizJob {
    id               Int       @id @default(autoincrement())
    document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
    documentId       Int
    status           JobStatus @default(queued)
    stage            JobStage?
    questionsWritten Int       @default(0)
    // The BullMQ run that owns this job; writes from older runs are ignored.
    attempts         Int       @default(0)
    // A message safe to show the user.
    error            String?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    finishedAt       DateTime?

    @@index([status])
    @@index([documentId])
    @@map("quiz_jobs")
}
