# "fake" runs without Google Cloud or the Claude API (see AGENTS.md). Use "real" in production.
PROVIDERS=fake
DATABASE_URL=postgres://myusername:mypassword@localhost:5432/mydb?schema=public
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=abcdefghijklymnopqrstuwxyz0123456789
GCLOUD_PROJECT_ID=
GCLOUD_LOCATION=us
GCLOUD_DOCUMENT_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=tmp/gcloud-key.json
# Optional: set to "real" to generate quizzes with Claude while PROVIDERS=fake
QUIZ_GENERATOR=
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
ANTHROPIC_MODEL=
REDIS_URL=redis://localhost:6379/0
