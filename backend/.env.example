DATABASE_URL=postgres://myusername:mypassword@localhost:5432/mydb?schema=public
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379/0

# better-auth. The secret signs session cookies (at least 32 characters; required in production).
BETTER_AUTH_SECRET=abcdefghijklmnopqrstuvwxyz0123456789
# The public URL of this backend; password reset links point here. Defaults to http://localhost:PORT.
BETTER_AUTH_URL=
# For better-auth's dashboard plugin (dash()).
BETTER_AUTH_API_KEY=

# How password reset emails go out: "console" prints the link to the log,
# "resend" sends it with Resend (needs RESEND_API_KEY).
EMAIL=console
RESEND_API_KEY=
# Sender address. Resend's test sender (the default) only delivers to your own Resend
# account's email; use an address on a domain verified in Resend for real users.
EMAIL_FROM=Quiz Qrafter <onboarding@resend.dev>

# Where uploads and transcripts are kept: "local" (backend/.data/) or "gcs" (Google Cloud Storage).
STORAGE=local
# For STORAGE=gcs only:
GOOGLE_APPLICATION_CREDENTIALS=tmp/gcloud-key.json
DOCUMENTS_BUCKET=quizqrafter-documents

# Who reads documents and writes quizzes: "gemini", or "fake" to work offline (see AGENTS.md).
AI=fake
GEMINI_API_KEY=
# Optional: defaults to gemini-4-hydrogen
LLM_MODEL=

# "inline" runs the quiz job worker inside the API server; "off" leaves it to `npm run worker`.
WORKER=inline
WORKER_CONCURRENCY=2
