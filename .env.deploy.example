# Copy to .env (gitignored) and fill in. kamal reads these from the shell, so export them first:
#   set -a; source .env; set +a
KAMAL_REGISTRY_PASSWORD= # gh auth token, with write:packages
POSTGRES_PASSWORD=       # openssl rand -hex 24
BETTER_AUTH_SECRET=      # openssl rand -hex 32
RESEND_API_KEY=          # sending key for quizqrafter.gdly.me
GEMINI_API_KEY=
