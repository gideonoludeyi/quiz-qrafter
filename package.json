{
    "name": "quiz-qrafter",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "workspaces": [
        "packages/*",
        "backend/",
        "frontend/"
    ],
    "scripts": {
        "start": "vp run --filter backend start",
        "build": "vp run --filter @quizqrafter/shared build && vp run --filter backend --filter frontend build",
        "dev": "vp run --filter @quizqrafter/shared build && vp run -r --parallel dev",
        "check-types": "vp run --filter @quizqrafter/shared build && vp run -r check-types",
        "prepare": "vp config",
        "e2e": "vp run --filter @quizqrafter/shared build && playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.0",
        "@types/node": "^26.6.6",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
        "vite-plus": "1.6.0"
    },
    "overrides": {
        "@vitejs/plugin-react-swc": {
            "vite": "$vite"
        },
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
    },
    "packageManager": "npm@11.6.0"
}
